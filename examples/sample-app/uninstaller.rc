#include <winres.h>
#include "version.h"

1 ICON "assets/uninstall.ico"
1 RT_MANIFEST "wizard.manifest"

/* The confirmation and completion pages' images: uninstaller.c reads them by these ids. */
101 RCDATA "assets/uninstall_confirm.png"
102 RCDATA "assets/uninstall_finished.png"

VS_VERSION_INFO VERSIONINFO
FILEVERSION    SAMPLE_VERSION_PARTS
PRODUCTVERSION SAMPLE_VERSION_PARTS
FILEOS         VOS_NT_WINDOWS32
FILETYPE       VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "FileDescription", "Sample App Uninstaller"
            VALUE "FileVersion", SAMPLE_VERSION
            VALUE "ProductName", "Sample App"
            VALUE "ProductVersion", SAMPLE_VERSION
            VALUE "CompanyName", "Sample Publisher"
            VALUE "OriginalFilename", "uninstall.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 0x04B0
    END
END
